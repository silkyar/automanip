    "cumulative_joint_actor_critic_calls": {
      "type": "integer",
      "minimum": 0
    },
    "cumulative_actor_optimizer_calls": {
      "type": "integer",
      "minimum": 0
    },
    "cumulative_critic_only_optimizer_calls": {
      "type": "integer",
      "minimum": 0
    },
    "cumulative_critic_optimizer_calls": {
      "type": "integer",
      "minimum": 0
    },
    "cumulative_optimizer_calls_total": {
      "type": "integer",
      "minimum": 0
    },
    "critic_only_training_rows": {
      "type": "integer",
      "minimum": 0
    },
    "cumulative_critic_only_training_rows": {
      "type": "integer",
      "minimum": 0
    },
    "critic_only_seconds": {
      "type": "number",
      "minimum": 0
    },
    "full_optimizer_loop_seconds": {
      "type": "number",
      "minimum": 0
    },
    "critic_only_deadline_skips": {
      "type": "integer",
      "minimum": 0
    },
    "critic_only_mean_value_loss": {
