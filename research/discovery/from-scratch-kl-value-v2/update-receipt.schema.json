    "actor_optimizer_calls": {
      "type": "integer",
      "minimum": 0
    },
    "critic_only_optimizer_calls": {
      "type": "integer",
      "minimum": 0
    },
    "critic_optimizer_calls": {
      "type": "integer",
      "minimum": 0
    },
    "optimizer_calls_total": {
      "type": "integer",
      "minimum": 0
